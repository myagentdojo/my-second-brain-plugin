{
  "name": "agent-plugin-template-tooling",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "update": "bun run scripts/update.ts",
    "init": "bun run scripts/init.ts",
    "generate": "bun run scripts/generate.ts",
    "generate:check": "bun run scripts/generate.ts --check",
    "release:validate": "bun run scripts/release-validate.ts",
    "build": "bun run scripts/build.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:claude": "bun run scripts/dev.ts claude watch",
    "dev:codex": "bun run scripts/dev.ts codex install",
    "ship:canary": "bun run scripts/ship-canary.ts",
    "readiness": "bun run scripts/repository-readiness.ts",
    "package": "bun run build && bun run scripts/package.ts",
    "prove:distribution": "bun run scripts/prove-distribution.ts",
    "prove:harness-install": "bun run scripts/prove-harness-install.ts",
    "prove:dx": "bun run scripts/prove-dx.ts",
    "prove:runtime-custody": "bun run scripts/prove-runtime-custody.ts",
    "prove:runtime-platform": "bun run scripts/prove-runtime-platform.ts",
    "prove:agent-browser-cdp": "bun packages/agent-browser/scripts/prove-cdp-compatibility.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prove:all": "bun test --path-ignore-patterns=scripts/runtime-custody-exec.test.ts && bun run typecheck && bun run generate:check && bun run release:validate && bun run prove:runtime-custody && bun run prove:harness-install -- --require-native --fixture-acknowledged && bun run prove:distribution && bun run prove:dx"
  },
  "dependencies": {
    "agent-plugin-kit": "git+https://github.com/myagentdojo/agent-plugin-kit.git#d0243de4319bbf83130fc8c80793c7f687fb454a"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "7.0.2"
  }
}
